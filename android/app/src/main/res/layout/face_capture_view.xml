<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/capturePreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Section - Instructions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/captureInstructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Position your face in the center"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/captureStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to capture"
                android:textColor="#00FF00"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Middle Section - Face Guide (Optional) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Face Oval Guide -->
            <View
                android:id="@+id/faceGuideOval"
                android:layout_width="250dp"
                android:layout_height="320dp"
                android:layout_gravity="center"
                android:background="@drawable/face_guide_oval" />

        </FrameLayout>

        <!-- Bottom Section - Captured Face Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:orientation="vertical"
            android:padding="12dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Captured Face Preview"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <ImageView
                android:id="@+id/capturedFaceImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:background="#333333"
                android:contentDescription="Captured face" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No face captured yet"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:gravity="center"
                android:paddingTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>